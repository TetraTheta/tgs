{
  "name": "tetralog-game-story",
  "private": true,
  "description": "Collection of game story",
  "author": "TetraTheta",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @tetralog/cli run cli clean && hugo --gc --minify -e production && pnpm --filter @tetralog/cli run cli deslash",
    "cli": "pnpm --filter @tetralog/cli run cli",
    "dev": "hugo server --renderToMemory --disableFastRender -D -p 44",
    "dev.prod": "hugo server --gc --minify --renderToMemory --disableFastRender -D -e production -p 44",
    "preinstall": "npx only-allow pnpm",
    "update": "pnpm dlx npm-check-updates --cooldown 7d --workspaces",
    "upgrade": "pnpm dlx npm-check-updates --cooldown 7d --workspaces -u && pnpm install"
  },
  "dependencies": {
    "katex": "^0.18.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.8",
    "typescript-eslint": "^8.70.1"
  }
}
